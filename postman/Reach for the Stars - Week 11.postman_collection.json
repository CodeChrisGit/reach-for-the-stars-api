                "exec": [
                  "pm.test(\"Session created\", () => {\r",
                  "  pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const session = pm.response.json();\r",
                  "pm.collectionVariables.set(\"code\", session.code || session.join_pin);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
